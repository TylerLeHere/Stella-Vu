---
import PhotoFrame from './PhotoFrame.astro';
import type { Photo } from '../data/types';
interface Props {
  photos: readonly Photo[];
}
const { photos } = Astro.props;
---

<section class="photographs container" aria-label="Favorite photographs">
  <ul>
    {photos.map((photo, index) => (
      <li>
        <PhotoFrame photo={photo} priority={index === 0} />
      </li>
    ))}
  </ul>
</section>

<style>
  .photographs {
    padding-block: var(--space-48) var(--space-64);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-24);
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-24);
    list-style: none;
  }
  li {
    min-width: 0;
  }
  li:first-child {
    padding-top: var(--space-16);
  }
  li:last-child {
    padding-top: var(--space-32);
  }
  @media (max-width: 599px) {
    .photographs {
      padding-block: var(--space-32) var(--space-48);
    }
    ul {
      grid-template-columns: minmax(0, 288px);
      justify-content: center;
      gap: var(--space-48);
      padding-inline: var(--space-24);
    }
    li:first-child,
    li:last-child {
      padding-top: 0;
    }
  }
</style>
