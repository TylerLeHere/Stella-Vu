---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Introduction from '../components/Introduction.astro';
import PhotoComposition from '../components/PhotoComposition.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { openingPhotos } from '../data/photos';
import PhotoViewer from '../components/PhotoViewer.astro';
---

<BaseLayout {...profile.metadata}>
  <div id="home">
    <Header name={profile.name} links={profile.links} />
  </div>
  <main id="main" tabindex="-1">
    <Introduction name={profile.name} introduction={profile.introduction} />
    <PhotoComposition photos={openingPhotos} />
    <About text={profile.about} />
  </main>
  <Footer name={profile.name} links={profile.links} />
  <PhotoViewer />
</BaseLayout>
